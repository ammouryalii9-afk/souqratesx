# Example nginx site config for SouqrateX on Contabo.
# Copy to /etc/nginx/sites-available/souqratex, adjust DOMAIN, then:
#   ln -s /etc/nginx/sites-available/souqratex /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
# Use certbot afterwards to add HTTPS (required for Telegram webhook/WebApp):
#   certbot --nginx -d DOMAIN

server {
    listen 80;
    server_name DOMAIN;

    # Static frontend build (vaultx). Path-based routing mirrors the
    # Replit artifact layout: everything except /api is the SPA.
    root /path/to/repo/artifacts/vaultx/dist/public;
    index index.html;

    # ── API proxy ─────────────────────────────────────────────────────────────
    location /api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Hashed JS/CSS assets — cache forever (Vite changes filename on change) ─
    location ~* \.(js|css)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ── Images, fonts, icons — cache for a week ───────────────────────────────
    location ~* \.(png|jpg|jpeg|gif|webp|svg|ico|woff2?|ttf|eot)$ {
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    # ── index.html — NEVER cache (Telegram Mini App must always get the latest) ─
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # ── SPA fallback ──────────────────────────────────────────────────────────
    location / {
        try_files $uri /index.html;
    }
}
